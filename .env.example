NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Troublefree / Smart Trade API (server-side)
SMART_TRADE_API_BASE_URL=https://my.troublefree.nl/v3/api
SMART_TRADE_API_USER=your-basic-auth-username
SMART_TRADE_API_PASSWORD=your-basic-auth-password
SMART_TRADE_COMPANY_KEY=troublefree
# Optional
# SMART_TRADE_API_TIMEOUT_MS=15000
# Alleen voor de volledige Mailchimp-controle; standaard 60000 met automatische nieuwe pogingen.
# SMART_TRADE_MAILCHIMP_TIMEOUT_MS=60000

# Mailchimp Marketing API (alleen server-side)
MAILCHIMP_API_KEY=your-mailchimp-api-key
# Alleen nodig als de API-key niet eindigt op bijvoorbeeld -us21.
# MAILCHIMP_SERVER_PREFIX=us21
# Optioneel als er meerdere audiences zijn; anders kies je deze op Admin > Mailchimp.
# MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_API_KEY_EXPIRES_AT=2027-08-12
# Merge field voor bedrijfsnaam; wordt automatisch aangemaakt als deze ontbreekt.
MAILCHIMP_COMPANY_MERGE_FIELD=COMPANY
# De nachtelijke synchronisatie wordt bij iedere deploy automatisch om 04:00 ingepland.
# Optioneel uitschakelen:
# SALES_INSTALL_MAILCHIMP_CRON=0

# Troublefree / Smart Trade testadministratie (server-side)
SMART_TRADE_TEST_API_BASE_URL=https://master.st.smartdev.tf/v3/api
SMART_TRADE_TEST_API_USER=your-basic-auth-username
SMART_TRADE_TEST_API_PASSWORD=your-basic-auth-password
SMART_TRADE_TEST_COMPANY_KEY=troublefree_erik
# Optional
# SMART_TRADE_TEST_API_TIMEOUT_MS=15000

# Microsoft Outlook-concepten met PDF-bijlage
MICROSOFT_OUTLOOK_TENANT_ID=organizations
MICROSOFT_OUTLOOK_CLIENT_ID=your-app-registration-client-id
MICROSOFT_OUTLOOK_CLIENT_SECRET=your-app-registration-client-secret
SALES_OUTLOOK_ENCRYPTION_KEY=use-a-long-random-secret

# Klantgegevensformulier-notificaties via de lokale mailserver
SALES_CUSTOMER_FORM_NOTIFICATION_EMAIL=erik@smarttrade.nl
SALES_DEAL_ACTIVITY_NOTIFICATION_EMAIL=erik@smarttrade.nl
SALES_NOTIFICATION_FROM_EMAIL=notifications@sales.troublefree.nl
SALES_SENDMAIL_PATH=/usr/sbin/sendmail
SALES_PUBLIC_URL=https://sales.troublefree.nl
# Optioneel: vul een komma-gescheiden lijst in om niet alle gebruikers te mailen.
# SALES_WEEKLY_DEALS_RECIPIENTS=erik@smarttrade.nl,collega@smarttrade.nl

# Verplichte sms-verificatie voor de beveiligde implementatiepagina
MESSAGEBIRD_API_KEY=
MESSAGEBIRD_VERIFY_ORIGINATOR=SmartTrade
MESSAGEBIRD_VERIFY_TEMPLATE=Uw Smart Trade-code is: %token

# Digitale machtiging voor automatische incasso
SALES_SEPA_CREDITOR_NAME=Troublefree B.V.
# Vul de officiële incassant-ID van Troublefree in.
SALES_SEPA_CREDITOR_ID=
